{
  "name": "fluid-paint",
  "version": "1.0.0",
  "description": "Modernized fluid-paint by david.li",
  "main": "paint.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cerginio/fluid-paint.git"
  },
  "keywords": [
    "fluid",
    "paint",
    "gamification"
  ],
  "author": "creg (cerginio)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/cerginio/fluid-paint/issues"
  },
  "homepage": "https://github.com/cerginio/fluid-paint#readme",
  "scripts": {
    "dev": "cross-env NODE_ENV=development gulp serve",
    "build": "cross-env NODE_ENV=production gulp build",
    "clean": "gulp clean",
    "lint:shaders": "node debug/lint-shaders.js",
    "test:color": "node debug/color-parity-test.js",
    "test:pwa-assets": "node --test debug/pwa-assets-test.js",
    "test:pwa-assets:browser": "node debug/pwa-assets-browser-test.js",
    "test:pwa-release": "node --test debug/pwa-release-test.js",
    "test:pwa-release:browser": "node debug/pwa-release-browser-test.js",
    "test:pwa-worker": "node --test debug/pwa-worker-test.js",
    "test:pwa-worker:browser": "node debug/pwa-worker-browser-test.js",
    "pwa:phase4:eval": "node debug/pwa-phase4-eval.js",
    "test:pwa-readiness": "node --test debug/pwa-readiness-test.js",
    "test:pwa-readiness:browser": "node debug/pwa-readiness-browser-test.js",
    "pwa:phase5:eval": "node debug/pwa-phase5-eval.js",
    "test:pwa-detection": "node --test debug/pwa-detection-test.js",
    "test:pwa-detection:browser": "node debug/pwa-detection-browser-test.js",
    "test:pwa-activation": "node --test debug/pwa-activation-test.js",
    "test:pwa-activation:browser": "node debug/pwa-activation-browser-test.js",
    "pwa:phase7:eval": "node debug/pwa-phase7-eval.js",
    "pwa:phase6:eval": "node debug/pwa-phase6-eval.js",
    "test:pwa-sw": "node --test debug/pwa-sw-harness-test.js && node debug/pwa-sw-selftest.js",
    "test:pwa-sw:browser": "node debug/pwa-sw-selftest.js",
    "pwa:sw:review": "node debug/pwa-sw-selftest.js --review",
    "test:shader-bundle": "node --test debug/shader-bundle-test.js",
    "test:shader-bundle:gpu": "node debug/shader-bundle-gpu-test.js",
    "test:color-adapter": "node --test debug/paint-color-adapter-test.js",
    "test:color-adapter:gpu": "node debug/paint-color-adapter-gpu-test.js",
    "test:paint-palette:gpu": "node debug/paint-palette-gpu-test.js",
    "test:timing": "node debug/live-timing-test.js",
    "test:tilecraft": "node debug/tilecraft-stroke-player-test.js",
    "test:story-max": "node debug/story-max-scheduler-test.js",
    "test:session-replay:gpu": "node debug/session-replay-gpu-test.js",
    "test:session-codec": "node debug/session-codec-test.js",
    "test:session-ui": "node debug/session-recording-ui-test.js",
    "test:tilecraft-scale": "node debug/tilecraft-group-scale-test.js",
    "test:tilecraft:gpu": "node debug/tilecraft-story-gpu-test.js",
    "test:tilecraft:polyline:gpu": "node debug/tilecraft-origin-polyline-gpu-test.js",
    "test:story-ui": "node debug/story-player-ui-test.js",
    "test:story-recent": "node debug/story-recent-files-test.js",
    "test:story-demo": "node --test debug/story-demo-catalog-test.js",
    "test:story-demo:ui": "node debug/story-demo-ui-test.js",
    "test:live-gpu": "node debug/live-gpu-test.js",
    "test:bristle-shape": "node debug/bristle-shape-gpu-test.js",
    "test:bake": "node debug/bake-gpu-test.js",
    "test:ui-preset": "node debug/ui-preset-api-test.js",
    "test:ui-preset:browser": "node debug/ui-preset-browser-test.js",
    "test:fluid-control": "node debug/fluid-control-api-test.js"
  },
  "overrides": {
    "picomatch": "2.3.2"
  },
  "devDependencies": {
    "@playwright/cli": "^0.1.19",
    "autoprefixer": "^10.5.5",
    "cross-env": "^10.1.0",
    "cssnano": "^7.1.9",
    "gulp": "^5.0.1",
    "gulp-concat": "^2.6.1",
    "gulp-html-minifier-terser": "^8.0.0",
    "gulp-plumber": "^1.2.1",
    "gulp-postcss": "^10.0.0",
    "gulp-replace": "^1.1.4",
    "gulp-terser": "^2.1.0",
    "http-server": "^14.1.1"
  }
}
